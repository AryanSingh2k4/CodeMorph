# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI LLM Provider (Compatible with OpenAI, Groq, OpenRouter, Gemini OpenAI proxy, etc.)
AI_API_KEY=your-ai-api-key
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# GitHub Sandbox runner repository configuration
GITHUB_PAT=ghp_yourpersonalaccesstoken
SANDBOX_REPO_OWNER=your-github-username
SANDBOX_REPO_NAME=codemorph-sandbox
WEBHOOK_SECRET=super-secret-random-token-12345

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
